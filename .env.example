# ============================================
# AI Passage Creator 环境变量模板
# 用法: cp .env.example .env 然后填写真实值
# 此文件本身不含任何真实密钥，可安全提交
# ============================================

# ── 必填：数据库 & 缓存（docker compose fail-fast，缺一不可） ──
DB_ROOT_PASSWORD=           # MySQL root 密码
DB_PASSWORD=                # MySQL 应用用户密码（MYSQL_USER 默认 appuser）
REDIS_PASSWORD=             # Redis 密码

# ── 可选：数据库用户（默认 appuser） ──
# DB_USERNAME=appuser

# ── AI 模型提供方 ──
DASHSCOPE_API_KEY=          # 阿里云百炼（Qwen）API Key，文章创作默认模型
AGNES_API_KEY=              # Agnes AI API Key（OpenAI 兼容，skill 引擎默认模型）
# 兼容旧配置；AGNES_API_KEY 优先
AGNES_AI_API_KEY=

# ── LangSearch 真实联网搜索（research 技能） ──
# 不配置时 research 的搜索阶段返回"服务未配置"，LLM 退化为模型知识
LANGSEARCH_API_KEY=

# ── 腾讯云 COS（卡片/配图/手写存储） ──
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-guangzhou   # 默认广州
TENCENT_COS_BUCKET=

# ── Pexels 图片（非 VIP 默认配图源） ──
PEXELS_API_KEY=

# ── Stripe 支付（VIP 购买） ──
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=      # Stripe webhook 签名密钥

# ── 出站 Webhook 共享密钥（/webhook/test 验签） ──
# 留空则 webhook 功能禁用
WEBHOOK_SHARED_SECRET=
