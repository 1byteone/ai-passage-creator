#!/bin/sh
# pre-push 钩子 — 推送前快速安全检查
# 仅检查「未推送提交」中新增的大文件/密钥，避免全库扫描拖慢推送
# 用法: 通过 git config core.hooksPath .githooks 启用

REMOTE="$1"
URL="$2"

# 取未推送的提交范围（本分支领先其上游的 commits）
RANGE=""
if git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then
    RANGE="$(git rev-parse @{u})..HEAD"
else
    RANGE="$(git rev-list --max-parents=0 HEAD 2>/dev/null | tail -1)..HEAD"
fi

echo "→ pre-push: 检查推送范围 $RANGE"

# ─── 检查 1: 大文件（> 2MB）新增 ────────────────────
NEW_BLOBS=$(git diff --name-only "$RANGE" 2>/dev/null | head -100)
LARGE=""
for f in $NEW_BLOBS; do
    size=$(git cat-file -s "$(git rev-parse "HEAD:$f" 2>/dev/null)" 2>/dev/null)
    if [ -n "$size" ] && [ "$size" -gt 2097152 ] 2>/dev/null; then
        LARGE="$LARGE\n  $f ($((size/1024/1024)) MB)"
    fi
done

if [ -n "$LARGE" ]; then
    echo ""
    echo "⚠️  推送中包含较大文件（可能拖慢/失败 push）:"
    echo "$LARGE"
    echo ""
    echo "   建议: 加入 .gitignore 并 git rm --cached"
    echo "   强制推送: git push --no-verify"
    echo ""
    exit 1
fi

# ─── 检查 2: 硬编码密钥新增 ──────────────────────────
SECRETS=$(git diff "$RANGE" 2>/dev/null | grep -E "^\+" | grep -iE "sk-live|sk_test_[A-Za-z0-9]{20}|whsec_[A-Za-z0-9]{20}|AKID[A-Za-z0-9]{15}" | head -3)
if [ -n "$SECRETS" ]; then
    echo ""
    echo "⚠️  检测到疑似生产密钥，已阻止推送:"
    echo "$SECRETS"
    echo ""
    echo "   请改用 \${VAR:} 环境变量，参考 CONTRIBUTING.md"
    echo ""
    exit 1
fi

echo "→ pre-push: 检查通过"
exit 0
