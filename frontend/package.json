{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s type-check build-only check:bundle",
    "pure-build": "vite build",
    "openapi2ts": "openapi2ts",
    "preview": "vite preview",
    "build-only": "vite build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "type-check": "vue-tsc --build",
    "test:skill": "node --experimental-strip-types --test tests/skill-state.test.ts tests/rag-search.test.ts",
    "test:ui": "playwright test",
    "test:performance": "node scripts/check-performance.mjs --mode=smoke",
    "test:performance:release": "node scripts/check-performance.mjs --mode=release",
    "test": "run-s test:skill test:ui",
    "check": "run-s lint:check build test test:performance:release",
    "lint:check": "eslint .",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.12",
    "echarts": "^6.0.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.577.0",
    "marked": "^17.0.1",
    "pinia": "^3.0.3",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@playwright/test": "^1.62.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.15.32",
    "@types/sortablejs": "^1.15.9",
    "@umijs/openapi": "^1.13.15",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "@vue/tsconfig": "^0.7.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.29.0",
    "eslint-plugin-vue": "~10.2.0",
    "jiti": "^2.4.2",
    "lighthouse": "^13.4.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.5.3",
    "sass-embedded": "^1.97.2",
    "tslib": "^2.8.1",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vue-tsc": "^2.2.10"
  }
}
